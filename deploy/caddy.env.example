# The environment deploy/Caddyfile reads, as /etc/caddy/caddy.env on the server (loaded by the
# Caddy service's EnvironmentFile). No secret belongs here: the lock's hash lives only in
# /etc/caddy/lock.caddy on the server.
#
# DOMAIN: the apex host name; the Datalab answers there, velometer at velometer.<DOMAIN>, and
# www.<DOMAIN> redirects to the apex. The intended value is zaehlwerk-datalab.de.
DOMAIN=zaehlwerk-datalab.de
# SITE_ROOT: where the releases live (<SITE_ROOT>/{datalab,velometer}/current, <SITE_ROOT>/tiles).
SITE_ROOT=/srv
