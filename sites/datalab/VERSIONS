#       MartianMonoVF.ttf wght=<400|600> wdth=100 -o mm-<w>.ttf
#   uvx --from fonttools==4.66.1 python -I names.py mm-<w>.ttf mm-<w>-named.ttf <Regular|SemiBold>
#   uvx --from fonttools==4.66.1 --with brotli==1.2.0 pyftsubset <font> --unicodes=<RANGES> \
#       --layout-features='*' --name-IDs='*' --flavor=woff2 --output-file=<name>.woff2
